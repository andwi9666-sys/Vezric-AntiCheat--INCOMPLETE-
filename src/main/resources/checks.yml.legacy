# --- HitboxA: Per-hit ray vs hitbox (flick/KB aware). ---
HitboxA:
  enabled: true  # Master switch — false disables this check entirely.
  vl: 1.0  # Violation level added on each flag (higher = faster punishment ladder).
  attackFreshnessMs: 150  # Max ms since attack packet — ignore stale attacks.
  bufferToFlag: 5  # Buffer/evidence needed before flagging (raise to reduce false positives).
  bufferResetMs: 3000  # Ms without violations before buffer resets to zero.
  minDistance: 1.0  # Min reach (blocks) — closer hits skip ray/hitbox tests.
  minSampleWeight: 0.40  # Combat sample quality 0–1; below this skips the hit.
  vanillaExpansion: 0.1  # Extra lenience (blocks or ms)
  maxPingExpansion: 0.15  # Extra lenience (blocks or ms)
  pingExpansionFactor: 8.0E-4  # Ratio or scale factor
  sprintExpansion: 0.03  # Extra lenience (blocks or ms)
  comboExpansion: 0.05  # Extra lenience (blocks or ms)
  graceThreshold: 0.08  # Miss distance (blocks) treated as acceptable noise.
  blatantMissDistance: 0.45  # Check-specific tuning value

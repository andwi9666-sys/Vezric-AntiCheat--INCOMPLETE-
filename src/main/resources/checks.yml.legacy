  vl: 1.0  # Violation level added on each flag (higher = faster punishment ladder).
  minTrackedSpeed: 0.09  # Bound/limit for this check
  maxGroundSpeedWhileUsing: 0.19  # Bound/limit for this check
  bufferToFlag: 3  # Buffer/evidence needed before flagging (raise to reduce false positives).

# --- NoSlowB: Anticheat detection check. ---
NoSlowB:
  enabled: true  # Master switch — false disables this check entirely.
  vl: 1.0  # Violation level added on each flag (higher = faster punishment ladder).
  minTrackedSpeed: 0.10  # Bound/limit for this check
  maxNearSprintWhileUsing: 0.225  # Bound/limit for this check
  bufferToFlag: 2  # Buffer/evidence needed before flagging (raise to reduce false positives).

# --- FastBreakA: Anticheat detection check. ---
FastBreakA:
  enabled: true  # Master switch — false disables this check entirely.
  vl: 1.0  # Violation level added on each flag (higher = faster punishment ladder).
  toleranceRatio: 0.92  # Ratio or scale factor
  minExpectedMs: 100  # Time window in milliseconds
  absoluteAllowanceMs: 55  # Time window in milliseconds
  softBlockExtraAllowanceMs: 90  # Time window in milliseconds
  bufferToFlag: 2  # Buffer/evidence needed before flagging (raise to reduce false positives).

# --- FastBreakB: Anticheat detection check. ---
FastBreakB:
  enabled: true  # Master switch — false disables this check entirely.
  vl: 1.0  # Violation level added on each flag (higher = faster punishment ladder).
  sampleSize: 10  # Check-specific tuning value
  minSamples: 5  # Minimum hits in window before evaluation.
  instantBlockMinAvgMs: 80.0  # Time window in milliseconds
  minAvgRatio: 0.84  # Bound/limit for this check
  bufferToFlag: 2  # Buffer/evidence needed before flagging (raise to reduce false positives).

# =============================================================================
# ANTI-BYPASS HARDENING (v4)
# =============================================================================

BadPacketsTransactionA:
  enabled: true
  failVl: 1.0
  sentWithoutAckThreshold: 40
  graceMs: 2000
  bufferToFlag: 3

BadPacketsTransactionB:
  enabled: true
  failVl: 1.0
  burstThreshold: 4
  bufferToFlag: 2

SetbackAcceptA:
  enabled: true
  failVl: 1.0
  rejectDistance: 0.5
  bufferToFlag: 2

MultiActionsA:
  enabled: true
  failVl: 1.0

MultiActionsB:
  enabled: true
  failVl: 1.0

MultiActionsC:
  enabled: true
  failVl: 1.0
  moveOffsetThreshold: 0.03
  bufferToFlag: 3

MultiActionsD:
  enabled: true
  failVl: 0.8
  moveOffsetThreshold: 0.03

MultiActionsE:
  enabled: true
  failVl: 0.9
  bufferToFlag: 2

MultiActionsF:
  enabled: true
  failVl: 1.0

MultiActionsG:
  enabled: true
  failVl: 1.0

AutoBlockC:
  enabled: true
  failVl: 1.0
  bufferToFlag: 3

FlyF:
  enabled: true
  shadow: true
  vl: 1.0

NoSlowPrediction:
  enabled: true
  engineHorizontalOffset: 0.06
  bufferToFlag: 3
  failVl: 1.0

NoRotationA:
  maxRotationAgeMs: 120

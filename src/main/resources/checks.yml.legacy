# =============================================================================
# VezAntiCheat — Check Tuning (checks.yml)
# =============================================================================
# Edit per-check sensitivity here. Reload with /vez reload.
#
# QUICK GUIDE (every check can use these keys):
#   enabled        — true/false master switch
#   shadow         — true = detect & log only, no punish (use while tuning)
#   vl             — violation level per flag (higher = faster bans)
#   bufferToFlag   — evidence before flag (HIGHER = fewer false positives)
#
# Missing keys inherit from defaults: below.
# Tune live: /vez tune <CheckName> <key> [value]
# =============================================================================

checks-version: 4

defaults:
  enabled: true              # Master switch for checks that omit this key
  shadow: false              # true = tuning mode (no punishments)
  vl: 1.0                    # Default VL added per flag
  bufferToFlag: 4            # Default buffer before flagging (HIGHER = fewer FPs)
  setbackEnabled: true       # Teleport back on flag when supported
  setbackCooldownMs: 0       # Deprecated — setbacks fire every invalid packet (no cooldown)
  debug: false               # Verbose logging for this check
  useSimulationFallback: true  # Legacy speed checks: confirm via simulation first


# =============================================================================
# COMBAT — KillAura
# =============================================================================

# --- KillAuraA: Silent aura / post-hit rotation anomalies. ---
KillAuraA:
  enabled: true  # Master switch — false disables this check entirely.
  vl: 1.0  # Violation level added on each flag (higher = faster punishment ladder).
  attackFreshnessMs: 150  # Max ms since attack packet — ignore stale attacks.
  switchResetMs: 1200  # Time window in milliseconds
  switchWindowMs: 260  # Time window in milliseconds
  switchPrecisionGain: 1  # Check-specific tuning value
  switchNormalGain: 2  # Check-specific tuning value
  minSwitchWeight: 0.42  # Bound/limit for this check
  switchBufferToFlag: 2  # Check-specific tuning value
  timingHistorySize: 20  # Check-specific tuning value
  timingPruneWindowMs: 2000  # Time window in milliseconds
  timingWindowMs: 2000  # Time window in milliseconds
  timingMinSamples: 7  # Check-specific tuning value
  timingMinIntervals: 4  # Check-specific tuning value
  timingMaxIntervalMs: 500  # Time window in milliseconds
  timingMinMeanMs: 25.0  # Time window in milliseconds
  timingMaxMeanMs: 200.0  # Time window in milliseconds
  timingMinWeight: 0.52  # Check-specific tuning value
  timingMaxCV: 0.14  # Check-specific tuning value
  timingMaxStd: 16.0  # Check-specific tuning value
  maxClickStdMs: 8.0  # Time window in milliseconds
  timingExtraClickStdMs: 4.0  # Time window in milliseconds
  varianceDropPrevCvMin: 0.15  # Check-specific tuning value
  varianceDropCvMax: 0.06  # Check-specific tuning value
  varianceDropMinMeanMs: 30.0  # Time window in milliseconds
  varianceDropMaxMeanMs: 120.0  # Time window in milliseconds

# --- KillAuraB: Multi-target switching patterns. ---
KillAuraB:
  enabled: true  # Master switch — false disables this check entirely.
  vl: 1.0  # Violation level added on each flag (higher = faster punishment ladder).
  attackFreshnessMs: 150  # Max ms since attack packet — ignore stale attacks.
  bufferHalveResetMs: 3000  # Time window in milliseconds
  bufferClearResetMs: 2000  # Time window in milliseconds
  minDot: 0.7  # Bound/limit for this check
  maxAngle: 24.0  # Bound/limit for this check
  closeRangeBypass: 1.1  # Check-specific tuning value
  rewindBaseMs: 60  # Lag-compensation rewind base (ms) added to ping-scaled window.
  rewindPingFactor: 0.2  # Ping multiplier for rewind window (ms per ping point).
  maxRewindMs: 140  # Cap on lag-compensation rewind (ms).
  minSampleWeight: 0.4  # Combat sample quality 0–1; below this skips the hit.
  blatantMinWeight: 0.5  # Check-specific tuning value
  bufferToFlag: 2  # Buffer/evidence needed before flagging (raise to reduce false positives).
  packetCancelMinBuffer: 2  # Check-specific tuning value
  packetCancelMinSampleWeight: 0.60  # Check-specific tuning value
  packetCancelMinDot: 0.54  # Check-specific tuning value
  packetCancelMinAngle: 34.0  # Check-specific tuning value

# --- KillAuraC: Aim snap on attack. ---
KillAuraC:
  enabled: true  # Master switch — false disables this check entirely.
  vl: 1.0  # Violation level added on each flag (higher = faster punishment ladder).
  bufferToFlag: 6  # Buffer/evidence needed before flagging (raise to reduce false positives).

# --- KillAuraD: Engine-backed aim geometry. ---
KillAuraD:
  enabled: true  # Master switch — false disables this check entirely.
  vl: 1.0  # Violation level added on each flag (higher = faster punishment ladder).
  attackFreshnessMs: 150  # Max ms since attack packet — ignore stale attacks.
  minSnapYaw: 70.0  # Bound/limit for this check
  blatantSnapYaw: 120.0  # Check-specific tuning value
  maxPitchStep: 15.0  # Bound/limit for this check
  maxSnapToAttackMs: 50  # Time window in milliseconds
  maxPostSnapAngle: 1.5  # Bound/limit for this check
  blatantMaxPostSnapAngle: 0.8  # Check-specific tuning value
  minDistance: 1.5  # Min reach (blocks) — closer hits skip ray/hitbox tests.
  historyWindowMs: 150  # Time window in milliseconds
  minHistorySamples: 3  # Bound/limit for this check
  rewindBaseMs: 60  # Lag-compensation rewind base (ms) added to ping-scaled window.
  rewindPingFactor: 0.20  # Ping multiplier for rewind window (ms per ping point).
  maxRewindMs: 160  # Cap on lag-compensation rewind (ms).
  bufferToFlag: 6  # Buffer/evidence needed before flagging (raise to reduce false positives).
  bufferResetMs: 2500  # Ms without violations before buffer resets to zero.

# --- KillAuraE: Hit ratio / center mass. ---
KillAuraE:
  enabled: true  # Master switch — false disables this check entirely.
  vl: 1.5  # Violation level added on each flag (higher = faster punishment ladder).
  attackFreshnessMs: 150  # Max ms since attack packet — ignore stale attacks.
  aggregateWindowMs: 3000  # Time window in milliseconds
  aggregateFamilyCooldownMs: 150  # Time window in milliseconds
  aggregateStateMinGapMs: 250  # Time window in milliseconds
  aggregateCooldownStateMinGapMs: 125  # Time window in milliseconds
  aggregateFamilyMaxContribution: 4  # Check-specific tuning value
  aggregateMaxBuffer: 8  # Check-specific tuning value
  aggregateCandidateBuffer: 1  # Check-specific tuning value
  aggregateBufferToPressure: 2  # Check-specific tuning value
  aggregateMinFamilies: 1  # Check-specific tuning value
  aggregateBufferToFlag: 2  # Check-specific tuning value
  aggregateMinFamiliesToFlag: 1  # Check-specific tuning value
  aggregateSoloBufferToFlag: 2  # Check-specific tuning value
  aggregateSilentMinBuffer: 3  # Check-specific tuning value
  aggregateSilentMinFamilies: 1  # Check-specific tuning value
  aggregateSilentMinAimScore: 1  # Check-specific tuning value
  aggregateSilentMinSnapScore: 1  # Check-specific tuning value
  aggregateSilentRearmMs: 150  # Time window in milliseconds
  aggregateSilentExistingDropStateMinGapMs: 125  # Time window in milliseconds

# --- KillAuraF: Aim vs hitbox alignment (feeder). ---
KillAuraF:
  enabled: true  # Master switch — false disables this check entirely.
  standalone: false  # true = flags alone; false = feeds aggregate check only.
  vl: 1.0  # Violation level added on each flag (higher = faster punishment ladder).
  attackFreshnessMs: 150  # Max ms since attack packet — ignore stale attacks.
  stateResetMs: 2500  # Time window in milliseconds
  minIntervalMs: 60  # Time window in milliseconds
  maxIntervalMs: 450  # Time window in milliseconds
  minTargetMove: 0.10  # Bound/limit for this check
  maxAttackYawStep: 1.6  # Bound/limit for this check
  maxAttackPitchStep: 1.05  # Bound/limit for this check
  maxCenterAngle: 1.10  # Bound/limit for this check
  maxCenterMargin: 0.18  # Bound/limit for this check
  minLookDot: 0.990  # Bound/limit for this check
  minSampleWeight: 0.52  # Combat sample quality 0–1; below this skips the hit.
  blatantTargetMove: 0.20  # Check-specific tuning value
  blatantMaxYawStep: 0.95  # Check-specific tuning value
  blatantMaxPitchStep: 0.60  # Check-specific tuning value
  blatantMaxCenterAngle: 0.70  # Check-specific tuning value
  blatantMaxCenterMargin: 0.10  # Check-specific tuning value
  blatantMinLookDot: 0.994  # Check-specific tuning value
  blatantMinWeight: 0.60  # Check-specific tuning value
  bufferToFlag: 5  # Buffer/evidence needed before flagging (raise to reduce false positives).
  packetCancelMinBuffer: 5  # Check-specific tuning value
  packetCancelMinTargetMove: 0.24  # Check-specific tuning value

# --- KillAuraG: Rotation delta patterns (feeder). ---
KillAuraG:
  enabled: true  # Master switch — false disables this check entirely.
  standalone: false  # true = flags alone; false = feeds aggregate check only.
  vl: 1.0  # Violation level added on each flag (higher = faster punishment ladder).
  failVl: 1.0  # VL weight when this prediction check flags.
  attackFreshnessMs: 150  # Max ms since attack packet — ignore stale attacks.
  maxDeltaDeg: 45.0  # Bound/limit for this check
  minLearnedGcd: 0.0015  # Bound/limit for this check
  combatWindowMs: 3000  # Time window in milliseconds
  windowSize: 40  # Check-specific tuning value
  severeRatioThreshold: 0.30  # Threshold — raise to reduce false positives
  suspectRatioThreshold: 0.45  # Threshold — raise to reduce false positives
  goodRatioThreshold: 0.60  # Threshold — raise to reduce false positives
  bufferToFlag: 8  # Buffer/evidence needed before flagging (raise to reduce false positives).

# --- KillAuraH: Aggregate killaura corroboration. ---
KillAuraH:
  enabled: true  # Master switch — false disables this check entirely.
  vl: 2.0  # Violation level added on each flag (higher = faster punishment ladder).
  attackFreshnessMs: 150  # Max ms since attack packet — ignore stale attacks.
  aggregateBufferToFlag: 5  # Check-specific tuning value
  aggregateMinFamilies: 2  # Check-specific tuning value
  soloBufferToFlag: 9  # Buffer needed when only one simulation source fired (raise for lenience).
  silentEscalationAimMin: 4  # Check-specific tuning value
  silentEscalationSecondaryMin: 2  # Check-specific tuning value

# =============================================================================
# COMBAT — Reach / Hitbox / BackTrack
# =============================================================================

# --- ReachA: Primary reach distance check. ---
ReachA:
  enabled: true  # Master switch — false disables this check entirely.
  vl: 1.0  # Violation level added on each flag (higher = faster punishment ladder).
  attackFreshnessMs: 180  # Max ms since attack packet — ignore stale attacks.
  max: 3.0  # Bound/limit for this check
  baseTolerance: 0.15  # Threshold — raise to reduce false positives
  pingToleranceFactor: 6.0E-4  # Ratio or scale factor
  maxPingTolerance: 0.20  # Threshold — raise to reduce false positives
  sprintTolerance: 0.06  # Threshold — raise to reduce false positives
  airTolerance: 0.04  # Threshold — raise to reduce false positives
  sprintBonus: 0.05  # Check-specific tuning value
  attackerMoveWindowMs: 600  # Time window in milliseconds
  attackerMoveTolerance: 0.10  # Threshold — raise to reduce false positives
  rewindBaseMs: 100  # Lag-compensation rewind base (ms) added to ping-scaled window.
  rewindPingFactor: 0.4  # Ping multiplier for rewind window (ms per ping point).
  maxRewindMs: 350  # Cap on lag-compensation rewind (ms).
  bufferToFlag: 5  # Buffer/evidence needed before flagging (raise to reduce false positives).
  comboWindowMs: 800  # Time window in milliseconds
  comboTolerance: 0.30  # Threshold — raise to reduce false positives
  comboPerfectHitTolerance: 0.14  # Threshold — raise to reduce false positives
  comboMinDisplacement: 0.24  # Check-specific tuning value
  comboMinShift: 0.09  # Check-specific tuning value
  comboSoftOver: 0.08  # Check-specific tuning value
  parryTolerance: 0.05  # Threshold — raise to reduce false positives
  quarterSelectTolerance: 0.07  # Threshold — raise to reduce false positives
  deepSelectTolerance: 0.12  # Threshold — raise to reduce false positives
  tripleHitTolerance: 0.06  # Threshold — raise to reduce false positives
  spacingTolerance: 0.07  # Threshold — raise to reduce false positives
  dirtySampleTolerance: 0.14  # Threshold — raise to reduce false positives
  lagCoverCurrentMargin: 0.10  # Check-specific tuning value
  lagCoverShiftMin: 0.15  # Check-specific tuning value
  lagCoverAgeMinMs: 95  # Time window in milliseconds
  lagCoverBufferToFlag: 4  # Check-specific tuning value
  lagCoverLowerBufferScore: 2.0  # Check-specific tuning value
  packetCancelMinOver: 0.16  # Check-specific tuning value
  packetCancelMinBuffer: 5  # Check-specific tuning value
  packetCancelMinSampleWeight: 0.65  # Check-specific tuning value


  velocityExemptExpansion: 0.10  # Extra lenience (blocks or ms)
  attackerAirborneExpansion: 0.05  # Extra lenience (blocks or ms)
  targetAirborneExpansion: 0.10  # Extra lenience (blocks or ms)
  tradeComboExpansion: 0.04  # Extra lenience (blocks or ms)
  jumpResetExpansion: 0.05  # Extra lenience (blocks or ms)

# --- HitboxB: Statistical hitbox miss ratio. ---
HitboxB:
